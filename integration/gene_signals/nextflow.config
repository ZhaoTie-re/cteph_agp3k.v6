/* ============================================================================
 * gene_signals — execution profile
 *
 * Resources go through clusterOptions --rsc ONLY. Nextflow's own cpus/memory
 * directives are rejected by this site's submitter, and `task.cpus` is unusable
 * because it defaults to 1 rather than null. Tools therefore read
 * `task.ext.threads`.
 *
 * MEMORY IS 4,571 MB PER CORE at this site. Asking for more than cores x 4571
 * silently doubles the core count, so every m= below is a whole multiple of it.
 *
 * The component is small: 17 short SLURM jobs + 1 local task. Measured peaks:
 * ASSEMBLE / WRITE_TABLE < 0.5 GB; plink2 on the 67-M-variant 1000 Genomes EAS
 * panel ~5.7 GB (REF_1KG, as in saige_signals); RV_QC_STATS streams the 16-20-M
 * row variant table in 2-M-row chunks of three columns.
 * ==========================================================================*/

// Here rather than in the .nf so that the run records follow --out_dir.
params.out_dir      = "${projectDir}/results"
params.run_info_dir = "${params.out_dir}/_run_info"

params.threadsOne = 1
params.threadsTwo = 2
params.threadsFour = 4

process {
    // 'finish' rather than 'terminate': a failing task lets the running ones
    // complete, and a -resume after the fix starts from their cached results.
    errorStrategy = 'finish'

    withName: 'SELECT_GENES|REF_TOMMO|VARIANT_SETS|ASSEMBLE|WRITE_TABLE' {
        ext.threads    = params.threadsOne
        clusterOptions = "--rsc p=1:t=${params.threadsOne}:c=${params.threadsOne}:m=4571M"
    }
    withName: 'GENOTYPE_STATS|ANNOTATE_FUNCTION|REF_ANNOVAR|RV_QC_STATS' {
        // plink2 on the cohort call set / EnsDb in R / ANNOVAR's in-memory index / the
        // per-sample OLS and the chunked variant table
        ext.threads    = params.threadsTwo
        clusterOptions = "--rsc p=1:t=${params.threadsTwo}:c=${params.threadsTwo}:m=9142M"
    }
    withName: 'MAP_RECOUNT' {
        // the upstream build_gene_map.py on 22 chromosomes, 4 at a time (~0.8 GB each, measured upstream)
        ext.threads    = params.threadsFour
        clusterOptions = "--rsc p=1:t=${params.threadsFour}:c=${params.threadsFour}:m=18284M"
    }
    withName: 'LOVO' {
        // plink2 --extract on the cohort call set (capped below the job's limit) and rvtest with
        // --numThread 4, as assoc_gene's RVTEST ran
        ext.threads    = params.threadsFour
        ext.plink_mb   = 12000
        clusterOptions = "--rsc p=1:t=${params.threadsFour}:c=${params.threadsFour}:m=18284M"
    }
    withName: 'REF_1KG' {
        // plink2 --freq on the 67-M-variant EAS panel needs ~5.7 GB (measured);
        // plink2 sizes its workspace from the NODE's RAM, so it is capped
        // explicitly with --memory below the job's limit.
        ext.threads    = params.threadsFour
        ext.plink_mb   = 12000
        clusterOptions = "--rsc p=1:t=${params.threadsFour}:c=${params.threadsFour}:m=18284M"
    }
}

// Provenance: a trace is the only way to tell a cached task from a completed one.
trace {
    enabled   = true
    overwrite = true
    file      = "${params.run_info_dir}/trace.txt"
    fields    = 'task_id,hash,name,status,exit,attempt,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.run_info_dir}/report.html"
}
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.run_info_dir}/timeline.html"
}
dag {
    enabled   = true
    overwrite = true
    file      = "${params.run_info_dir}/dag.html"
}

manifest {
    name        = 'gene_signals'
    mainScript  = 'gene_signals.nf'
    description = 'Workbook of the gene-based rare-variant association signals across three nested cohorts: burden and SKAT-O / CMC results, the variants behind them annotated as in the common-variant table (incl. Open Targets), the analysed variant sets by impact and consequence, the scan summaries and the rare-variant QC table.'
}
