/* ============================================================================
 * hla_records — execution profile
 *
 * Resources go through clusterOptions --rsc ONLY. Nextflow's own cpus/memory
 * directives are rejected by this site's submitter, and `task.cpus` is unusable
 * because it defaults to 1 rather than null.
 *
 * MEMORY IS 4,571 MB PER CORE at this site. Asking for more than cores x 4571
 * silently doubles the core count, so every m= below is a whole multiple of it.
 *
 * The component is small: 11 short SLURM jobs + 1 local task. Measured locally:
 * every table script < 1 GB and < 1 min; RECHECK reads the dosage matrices
 * (3,101 x 2,872) and the 48 per-run tables in ~15 s; AUDIT re-reads ~0.5 M
 * cells with openpyxl in ~3.5 min.
 *
 * Queue: gr10478b. If its jobs sit PD with QOSGrpCpuLimit (the group's cores
 * are in use), run with --queue eb (1 h limit; every task here fits).
 * ==========================================================================*/

// Here rather than in the .nf so that the run records follow --out_dir.
params.out_dir      = "${projectDir}/results"
params.run_info_dir = "${params.out_dir}/_run_info"
params.queue        = 'gr10478b'

process {
    // 'finish' rather than 'terminate': a failing task lets the running ones
    // complete, and a -resume after the fix starts from their cached results.
    errorStrategy = 'finish'

    withName: 'TYPING_VERIFY|UPSTREAM|TYPING_TABLES|GWAS_LAMBDA|ASSOC_TABLES|DECK_INDEX|DECK_CHECK|RECHECK|WRITE_WORKBOOK' {
        clusterOptions = '--rsc p=1:t=1:c=1:m=4571M'
    }
    withName: 'AUDIT' {
        // openpyxl holds the whole workbook with its rich-text runs
        clusterOptions = '--rsc p=1:t=2:c=2:m=9142M'
    }
}

// Provenance: a trace is the only way to tell a cached task from a completed one.
trace {
    enabled   = true
    overwrite = true
    file      = "${params.run_info_dir}/trace.txt"
    fields    = 'task_id,hash,name,status,exit,attempt,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.run_info_dir}/report.html"
}
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.run_info_dir}/timeline.html"
}
dag {
    enabled   = true
    overwrite = true
    file      = "${params.run_info_dir}/dag.html"
}

manifest {
    name        = 'hla_records'
    mainScript  = 'hla_records.nf'
    description = 'One workbook recording the HLA typing and the HLA association in the order and terms of their two decks: typing run, completeness, panel comparison, marker QC, every allele and residue column; design, thresholds, Q1-Q3, inflation, the DQB1 57 V summary, the DVT comparisons, the reported alleles and every test, each record checked against the decks, recomputed independently, and audited after writing.'
}
