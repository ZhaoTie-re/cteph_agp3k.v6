/* ============================================================================
 * saige_signals — execution profile
 *
 * Resources go through clusterOptions --rsc ONLY. Nextflow's own cpus/memory
 * directives are rejected by this site's submitter, and `task.cpus` is unusable
 * because it defaults to 1 rather than null. Tools therefore read
 * `task.ext.threads`.
 *
 * MEMORY IS 4,571 MB PER CORE at this site. Asking for more than cores x 4571
 * silently doubles the core count, so every m= below is a whole multiple of it.
 *
 * The component is small: ~60 short jobs. Measured peaks: plink2 on the
 * 67-M-variant 1000 Genomes EAS panel ~5.7 GB (REF_1KG); a SuSiE refit of an HLA
 * window ~1.4 GB; EnsDb in R ~1-2 GB; ToMMo slices 0.12 GB once the unused INFO
 * is stripped before bcftools norm (4.5 GB with it: the OOM of the first run).
 * ==========================================================================*/

// Here rather than in the .nf so that the run records follow --out_dir: a
// `--out_dir results.spa` run cannot overwrite results/_run_info.
params.out_dir      = "${projectDir}/results"
params.run_info_dir = "${params.out_dir}/_run_info"

params.threadsOne = 1
params.threadsTwo = 2
params.threadsFour = 4

process {
    // 'finish' rather than 'terminate': a failing task lets the running ones
    // complete, and a -resume after the fix starts from their cached results.
    errorStrategy = 'finish'

    withName: 'SELECT_SIGNALS|ASSOC_STATS|SUSIE_REFIT|CS_STATUS|REF_TOMMO|ASSEMBLE|WRITE_TABLE' {
        ext.threads    = params.threadsOne
        clusterOptions = "--rsc p=1:t=${params.threadsOne}:c=${params.threadsOne}:m=4571M"
    }
    withName: 'GENOTYPE_STATS|ANNOTATE_FUNCTION|REF_GNOMAD' {
        // plink2 on the cohort bed / EnsDb in R / ANNOVAR's in-memory index
        ext.threads    = params.threadsTwo
        clusterOptions = "--rsc p=1:t=${params.threadsTwo}:c=${params.threadsTwo}:m=9142M"
    }
    withName: 'REF_1KG' {
        // plink2 --freq on the 67-M-variant EAS panel needs ~5.7 GB (measured);
        // plink2 sizes its workspace from the NODE's RAM, so it is capped
        // explicitly with --memory below the job's limit.
        ext.threads    = params.threadsFour
        ext.plink_mb   = 12000
        clusterOptions = "--rsc p=1:t=${params.threadsFour}:c=${params.threadsFour}:m=18284M"
    }
}

// Provenance: a trace is the only way to tell a cached task from a completed one.
trace {
    enabled   = true
    overwrite = true
    file      = "${params.run_info_dir}/trace.txt"
    fields    = 'task_id,hash,name,status,exit,attempt,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.run_info_dir}/report.html"
}
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.run_info_dir}/timeline.html"
}
dag {
    enabled   = true
    overwrite = true
    file      = "${params.run_info_dir}/dag.html"
}

manifest {
    name        = 'saige_signals'
    mainScript  = 'saige_signals.nf'
    description = 'Academic one-sheet table of the SAIGE association signals across three nested cohorts: per-cohort statistics, SuSiE credible-set status re-derived from the stored fits, genotypes, snpEff / Ensembl 86 annotation, and ToMMo / 1000 Genomes / gnomAD frequencies.'
}
