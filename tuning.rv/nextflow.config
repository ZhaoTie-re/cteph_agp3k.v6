// ── Provenance ────────────────────────────────────────────────────────────
manifest {
    name        = 'tuning.rv'
    description = 'Rare-variant depth/platform-confounding QC (rate + OLS) + null-calibrated minAC recommendation across cohorts (+ cross-cohort comparison).'
    version     = '4.0'
}

// One run now covers all cohorts, so execution reports are RUN-level (not
// per-cohort) under results/_run_info/. (Paths inlined — strict config parser
// forbids `def` here.)
trace.enabled    = true
trace.overwrite  = true
trace.file       = "/LARGE0/gr10478/b37974/Pulmonary_Hypertension/cteph_agp3k.v6/tuning.rv/results/_run_info/trace.txt"
trace.fields     = 'task_id,hash,name,status,exit,attempt,realtime,%cpu,peak_rss,duration'
report.enabled   = true
report.overwrite = true
report.file      = "/LARGE0/gr10478/b37974/Pulmonary_Hypertension/cteph_agp3k.v6/tuning.rv/results/_run_info/report.html"
timeline.enabled   = true
timeline.overwrite = true
timeline.file      = "/LARGE0/gr10478/b37974/Pulmonary_Hypertension/cteph_agp3k.v6/tuning.rv/results/_run_info/timeline.html"
dag.enabled    = true
dag.overwrite  = true
dag.file       = "/LARGE0/gr10478/b37974/Pulmonary_Hypertension/cteph_agp3k.v6/tuning.rv/results/_run_info/dag.html"

// ── Per-process resources (Fujitsu --rsc) ────────────────────────────────────
process {
    withName: 'CALC_METRICS_BASE' {
        clusterOptions = '--rsc p=1:t=4:c=2:m=9142M'
    }
    withName: 'DETECT_OUTLIER_SAMPLES' {
        clusterOptions = '--rsc p=1:t=2:c=2:m=8000M'
    }
    withName: 'PLOT_RATE_DISTRIBUTION' {
        clusterOptions = '--rsc p=1:t=2:c=2:m=8000M'
    }
    withName: 'FILTER_SAMPLES' {
        clusterOptions = '--rsc p=1:t=4:c=2:m=9142M'
    }
    withName: 'CALC_VARIANT_METRICS' {
        clusterOptions = '--rsc p=1:t=4:c=2:m=9142M'
    }
    withName: 'DETECT_DEPTHDIFF_VARIANTS' {
        clusterOptions = '--rsc p=1:t=2:c=2:m=16000M'
    }
    withName: 'FILTER_VARIANTS' {
        clusterOptions = '--rsc p=1:t=4:c=2:m=9142M'
    }
    withName: 'CALC_METRICS' {
        clusterOptions = '--rsc p=1:t=4:c=2:m=9142M'
    }
    withName: 'QC_SUMMARY' {
        clusterOptions = '--rsc p=1:t=1:c=1:m=4096M'
    }
    withName: 'MERGE_QC_SUMMARIES' {
        clusterOptions = '--rsc p=1:t=1:c=1:m=2048M'
    }
    withName: 'SELECT_MINAC' {
        clusterOptions = '--rsc p=1:t=1:c=1:m=2048M'
    }
    withName: 'PLOT_SWEEP' {
        clusterOptions = '--rsc p=1:t=1:c=1:m=2048M'
    }
    withName: 'WRITE_RUN_MANIFEST' {
        clusterOptions = '--rsc p=1:t=1:c=1:m=2048M'
    }
    withName: 'COMPARE_COHORTS' {
        clusterOptions = '--rsc p=1:t=1:c=1:m=2048M'
    }
}
