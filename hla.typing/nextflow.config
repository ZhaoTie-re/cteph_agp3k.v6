// hla.typing — execution profile.
// Resources go through --rsc only. Tools read `ext.threads` (task.cpus is unusable:
// it defaults to 1, so an elvis fallback silently runs single-threaded).
// --rsc t=threads, c=cores; this site also permits t = 2c.
//
// MEMORY IS CHARGED IN UNITS OF 4,571 MB PER CORE at this site. Ask for more than
// c x 4571 and the site's cli_filter SILENTLY RAISES c= — `c=4:m=36568M` submits as
// c=8 — saying so only on stderr at submit time. Verified with `sbatch --test-only`.
// So the `c=` written below is the LOWER bound on what a job is charged, and the
// figures here are the ones that were measured to work, not the ones billed.

params.threadsExtract = 4     // samtools view/collate/fastq over one CRAM
params.threadsHlahd   = 4     // hlahd.sh -t : bowtie2 -p AND 4-way parallel hla_est
params.threadsSmall   = 2     // manifest, collect, residue matrix, QC, figures

// The only concurrency limit in the component, and it is on I/O rather than CPU.
// HLAHD is compute-bound and is left unlimited; the scheduler is the right place
// to bound that.
params.maxForksExtract = 48

process {
    // No retries by default: a failure should be loud. The one exception is HLAHD,
    // where the failure mode is an out-of-memory kill of hla_est that the tool
    // itself reports as success — see the errorStrategy below.
    errorStrategy = 'terminate'

    // Reads one 19-67 GB CRAM over ~540 regions and writes a few hundred MB of
    // FASTQ. I/O bound, not memory bound — which is why it is the one process with
    // a fork limit. 3,569 of these at once would pull ~88 TB off a SHARED Lustre
    // filesystem as fast as the scheduler can start them, and the cost of that
    // lands on everyone using it, not only on this run. 48 keeps the extraction
    // off the critical path (the pilot ran ~6 min per sample) without doing that.
    withName: 'EXTRACT_READS' {
        ext.threads    = params.threadsExtract
        maxForks       = params.maxForksExtract
        clusterOptions = "--rsc p=1:t=${params.threadsExtract}:c=${params.threadsExtract}:m=8000M"
    }

    // Same argument, worse ratio: each of these reads a whole 20 GB CRAM to build
    // one index, and there are 111 of them.
    withName: 'INDEX_CRAM' {
        ext.threads    = params.threadsExtract
        maxForks       = params.maxForksExtract
        clusterOptions = "--rsc p=1:t=${params.threadsExtract}:c=${params.threadsExtract}:m=8000M"
    }

    // 36,568 MB, not the 2 GB the reference implementation used. At 2 GB, hla_est
    // for HLA-A and HLA-B is OOM-killed on roughly 2 % of samples; hlahd.sh does not
    // check its children, exits 0, and publishes a truncated result.
    //
    // validate_typing.py, which runs as the LAST LINE OF THE HLAHD PROCESS, is what
    // turns that into a non-zero exit — and because it is inside this process rather
    // than downstream of it, the ladder below is what the failure is retried on. As a
    // separate process its failure could only kill the run.
    //
    // 36,568 M against the 3.6-6.5 GB measured across the full 3,569-sample run: a
    // wide margin, and the ladder never fired once. It submits as c=8 rather than
    // c=4 (4,571 MB/core), which is the real cost of that margin.
    withName: 'HLAHD' {
        ext.threads    = params.threadsHlahd
        clusterOptions = { "--rsc p=1:t=${params.threadsHlahd}:c=${params.threadsHlahd}:m=${task.attempt > 1 ? 73136 : 36568}M" }
        errorStrategy  = { task.attempt <= 2 ? 'retry' : 'terminate' }
        maxRetries     = 2
    }

    withName: 'BUILD_MANIFEST|CONTIG_LIST|COLLECT_ALLELES|BUILD_RESIDUE_REF|RESIDUE_MATRIX|TYPING_QC|ALLELE_FREQ_CHECK|PLOT_TYPING_QC|PLOT_ALLELE_FREQ' {
        ext.threads    = params.threadsSmall
        clusterOptions = "--rsc p=1:t=${params.threadsSmall}:c=${params.threadsSmall}:m=18284M"
    }
}

// Provenance.
//
// overwrite=true is REQUIRED — without it a -resume run fails to rewrite these and leaves
// stale files describing a different run beside the current outputs. The cost is real and
// was paid: the 7 h 19 m full-cohort run's trace, with every task's duration and peak_rss,
// was destroyed by a 90-second QC -resume that rewrote it as 7,257 CACHED + 2 COMPLETED.
// A resume's trace describes the RESUME, never the run that did the work. Copy
// results/_run_info/trace.txt somewhere else before resuming if the timings matter.
params.run_info_dir = "${projectDir}/results/_run_info"

trace {
    enabled   = true
    overwrite = true
    file      = "${params.run_info_dir}/trace.txt"
    fields    = 'task_id,hash,name,status,exit,attempt,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
}
report   { enabled = true; overwrite = true; file = "${params.run_info_dir}/report.html" }
timeline { enabled = true; overwrite = true; file = "${params.run_info_dir}/timeline.html" }
dag      { enabled = true; overwrite = true; file = "${params.run_info_dir}/dag.html" }

manifest {
    name        = 'hla.typing'
    description = 'Read-based HLA allele typing (HLA-HD) and IMGT-numbered amino-acid residue calling.'
    version     = '1.0'
}
