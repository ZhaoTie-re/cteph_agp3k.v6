/* ============================================================================
 * assoc_gene — execution profile
 *
 * Resources go through clusterOptions --rsc ONLY. Nextflow's own cpus/memory
 * directives are rejected by this site's submitter, and `task.cpus` is unusable
 * because it defaults to 1 rather than null: an elvis fallback on it silently
 * runs single-threaded. Tools therefore read `task.ext.threads`.
 *
 * MEMORY IS 4,571 MB PER CORE at this site. Asking for more than cores x 4571
 * silently doubles the core count, so every m= below is a whole multiple of it:
 *   2 cores 9,142M · 4 cores 18,284M · 8 cores 36,568M
 *
 * The whole component is small. The 66 map chunks are the only stage that adds
 * up to an hour of CPU; rvtest CMC across all 264 tasks is ~15 minutes of CPU in
 * total and SKAT-O about 5.5 hours, spread over the cluster in minutes of wall
 * clock. Nothing here justifies more than 8 cores.
 * ==========================================================================*/

params.threadsMap   = 8
params.threadsChunk = 4
params.threadsAssoc = 4
params.threadsPlot  = 4
params.threadsSmall = 2

params.run_info_dir = "${projectDir}/results/_run_info"

process {
    // 'finish' rather than 'terminate'. Both report the same error and neither
    // retries; the difference is that 'terminate' KILLS every running task, so a
    // figure failing in six seconds would take 264 running RVTEST tasks down
    // with it. 'finish' lets what is already running complete, and a -resume
    // after the fix starts from their cached results.
    errorStrategy = 'finish'

    withName: 'MAKE_MINAC_KEEP|MERGE_MAP|EMIT_TEST_INPUTS' {
        // MAKE_MINAC_KEEP streams a 14 GB bed; MERGE_MAP holds 22 chromosomes
        // of map rows; EMIT_TEST_INPUTS materialises the tested bfile and its
        // VCF and decodes the bed once, per chromosome block, to count carriers.
        ext.threads    = params.threadsMap
        clusterOptions = "--rsc p=1:t=${params.threadsMap}:c=${params.threadsMap}:m=36568M"
    }
    withName: 'MAP_CHUNK' {
        // A streaming sorted-merge join of one chromosome's bim against the
        // pre-computed JHRP snpEff index, constant memory. Measured 14.4 s for
        // chr22 (89,074 minAC-passing variants).
        ext.threads    = params.threadsChunk
        clusterOptions = "--rsc p=1:t=${params.threadsChunk}:c=${params.threadsChunk}:m=18284M"
    }
    withName: 'RVTEST|SCAN' {
        ext.threads    = params.threadsAssoc
        clusterOptions = "--rsc p=1:t=${params.threadsAssoc}:c=${params.threadsAssoc}:m=18284M"
    }
    withName: 'PLOT_SCAN|PLOT_ANNOTATION|PLOT_GRID|PLOT_ROBUST_GENES|PLOT_GENE_DETAIL' {
        ext.threads    = params.threadsPlot
        clusterOptions = "--rsc p=1:t=${params.threadsPlot}:c=${params.threadsPlot}:m=18284M"
    }
    withName: 'SPLIT_BIM|PREP_PHENO_COV|MERGE_RVTEST|SIGNIFICANCE|ROBUSTNESS|GENE_MODELS|SCAN_SCALE' {
        ext.threads    = params.threadsSmall
        clusterOptions = "--rsc p=1:t=${params.threadsSmall}:c=${params.threadsSmall}:m=9142M"
    }
}

// overwrite = true means a -resume's trace REPLACES the original run's record.
// That is intended — the trace should describe the tree as it now stands — but
// a full run's timings are lost the moment it is resumed for a one-task fix.
// Copy _run_info/ aside before resuming if the timings matter.
trace    { enabled = true; overwrite = true; file = "${params.run_info_dir}/trace.txt"
           fields = 'task_id,hash,name,status,exit,attempt,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar' }
report   { enabled = true; overwrite = true; file = "${params.run_info_dir}/report.html" }
timeline { enabled = true; overwrite = true; file = "${params.run_info_dir}/timeline.html" }
dag      { enabled = true; overwrite = true; file = "${params.run_info_dir}/dag.html" }

manifest {
    name        = 'assoc_gene'
    description = 'Gene-based rare-variant association: one canonical snpEff variant map, rvtest CMC and SKAT-O, per-cohort Bonferroni and BH, tiered robustness across three nested cohorts.'
}
