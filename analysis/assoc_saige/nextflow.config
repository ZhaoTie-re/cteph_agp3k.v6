// assoc_saige — execution profile.
// Resources go through --rsc only. Tools read `ext.threads` (task.cpus is unusable:
// it defaults to 1, so an elvis fallback silently runs single-threaded).
// --rsc t=threads, c=cores; this site also permits t = 2c.

params.threadsFitNull     = 32  // full GRM on a few thousand samples: the heavy step
params.threadsRunAssoc    = 4   // SAIGE step 2, one chromosome
params.threadsSplitChrom  = 4   // plink2 --chr --make-bed
params.threadsPrune       = 8   // plink2 --indep-pairwise genome-wide
params.threadsScanPeaks   = 4   // holds every model's statistics for one cohort
params.threadsPlotScan    = 4   // every point drawn, no thinning
params.threadsConditional = 4   // SAIGE step 2 over one window, per round
params.threadsLdSources   = 4   // square LD matrix + reference-panel extraction
params.threadsSusie       = 2
params.threadsAnnotate    = 4
params.threadsLocusFigure = 2   // PLOT_REGIONAL / PLOT_FINEMAP / PLOT_CONDITIONAL
params.threadsCsVariants  = 2
params.threadsCrossCohort = 4
params.threadsSummary     = 2   // COMPARE_COHORTS
params.threadsSmall       = 2   // PREP_PHENO_COV / MERGE_ASSOC / TO_SUMSTATS

process {
    errorStrategy = 'terminate'

    // A full GRM is O(N^2) in memory and the dominant cost of the whole pipeline.
    withName: 'FIT_NULL' {
        ext.threads    = params.threadsFitNull
        clusterOptions = "--rsc p=1:t=${params.threadsFitNull}:c=${params.threadsFitNull}:m=146272M"
    }
    withName: 'RUN_ASSOC' {
        ext.threads    = params.threadsRunAssoc
        clusterOptions = "--rsc p=1:t=${params.threadsRunAssoc}:c=${params.threadsRunAssoc}:m=73136M"
    }
    // KING over ~380 k markers x a few thousand samples: minutes, but it holds
    // the whole lower triangle in memory.
    withName: 'RELATEDNESS' {
        ext.threads    = params.threadsPrune
        clusterOptions = "--rsc p=1:t=${params.threadsPrune}:c=${params.threadsPrune}:m=73136M"
    }
    withName: 'COMPARE_RELATEDNESS' {
        ext.threads    = params.threadsSummary
        clusterOptions = "--rsc p=1:t=${params.threadsSummary}:c=${params.threadsSummary}:m=36568M"
    }
    withName: 'PRUNE_MARKERS' {
        ext.threads    = params.threadsPrune
        clusterOptions = "--rsc p=1:t=${params.threadsPrune}:c=${params.threadsPrune}:m=73136M"
    }
    withName: 'SPLIT_BY_CHROM' {
        ext.threads    = params.threadsSplitChrom
        clusterOptions = "--rsc p=1:t=${params.threadsSplitChrom}:c=${params.threadsSplitChrom}:m=36568M"
    }
    withName: 'PREP_PHENO_COV|MERGE_ASSOC|TO_SUMSTATS' {
        ext.threads    = params.threadsSmall
        clusterOptions = "--rsc p=1:t=${params.threadsSmall}:c=${params.threadsSmall}:m=36568M"
    }
    withName: 'SCAN_PEAKS' {
        ext.threads    = params.threadsScanPeaks
        clusterOptions = "--rsc p=1:t=${params.threadsScanPeaks}:c=${params.threadsScanPeaks}:m=73136M"
    }
    withName: 'PLOT_SCAN' {
        ext.threads    = params.threadsPlotScan
        clusterOptions = "--rsc p=1:t=${params.threadsPlotScan}:c=${params.threadsPlotScan}:m=73136M"
    }
    withName: 'CONDITIONAL' {
        ext.threads    = params.threadsConditional
        clusterOptions = "--rsc p=1:t=${params.threadsConditional}:c=${params.threadsConditional}:m=73136M"
    }
    withName: 'LD_SOURCES' {
        ext.threads    = params.threadsLdSources
        clusterOptions = "--rsc p=1:t=${params.threadsLdSources}:c=${params.threadsLdSources}:m=73136M"
    }
    withName: 'SUSIE' {
        ext.threads    = params.threadsSusie
        clusterOptions = "--rsc p=1:t=${params.threadsSusie}:c=${params.threadsSusie}:m=36568M"
    }
    withName: 'ANNOTATE_LEADS' {
        ext.threads    = params.threadsAnnotate
        clusterOptions = "--rsc p=1:t=${params.threadsAnnotate}:c=${params.threadsAnnotate}:m=36568M"
    }
    withName: 'PLOT_REGIONAL|PLOT_FINEMAP|PLOT_CONDITIONAL' {
        ext.threads    = params.threadsLocusFigure
        clusterOptions = "--rsc p=1:t=${params.threadsLocusFigure}:c=${params.threadsLocusFigure}:m=18284M"
    }
    // Reads a few hundred small JSON files and writes one markdown table.
    withName: 'CATALOGUE_FIGURES' {
        ext.threads    = 1
        clusterOptions = "--rsc p=1:t=1:c=1:m=18284M"
    }
    withName: 'CS_VARIANTS' {
        ext.threads    = params.threadsCsVariants
        clusterOptions = "--rsc p=1:t=${params.threadsCsVariants}:c=${params.threadsCsVariants}:m=18284M"
    }
    withName: 'CROSS_COHORT' {
        ext.threads    = params.threadsCrossCohort
        clusterOptions = "--rsc p=1:t=${params.threadsCrossCohort}:c=${params.threadsCrossCohort}:m=73136M"
    }
    withName: 'COMPARE_COHORTS' {
        ext.threads    = params.threadsSummary
        clusterOptions = "--rsc p=1:t=${params.threadsSummary}:c=${params.threadsSummary}:m=18284M"
    }
    // The PLOT_SCAN tier: these read whole scans, not summary tables.
    withName: 'COMPARE_MANHATTAN|COMPARE_MODELS' {
        ext.threads    = params.threadsPlotScan
        clusterOptions = "--rsc p=1:t=${params.threadsPlotScan}:c=${params.threadsPlotScan}:m=73136M"
    }
}

// Provenance: without a trace there is no way to tell a cached task from a
// completed one after the fact, which is exactly what the cost discipline needs.
params.run_info_dir = "${projectDir}/results/_run_info"

trace {
    enabled   = true
    overwrite = true
    file      = "${params.run_info_dir}/trace.txt"
    fields    = 'task_id,hash,name,status,exit,attempt,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.run_info_dir}/report.html"
}
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.run_info_dir}/timeline.html"
}
dag {
    enabled   = true
    overwrite = true
    file      = "${params.run_info_dir}/dag.html"
}
