/* ============================================================================
 * assoc_hla.v2 — execution profile
 *
 * Resources go through clusterOptions --rsc ONLY. Nextflow's own cpus/memory
 * directives are rejected by this site's submitter, and `task.cpus` is unusable
 * because it defaults to 1 rather than null. Tools therefore read
 * `task.ext.threads`.
 *
 * MEMORY IS 4,571 MB PER CORE at this site. Asking for more than cores x 4571
 * silently doubles the core count, so every m= below is a whole multiple of it:
 *   2 cores 9,142M · 4 cores 18,284M · 8 cores 36,568M
 *
 * The tests are small: at most 3,101 samples x 681 markers per set. plink2
 * finishes a set in seconds; SAIGE step 2 in about 5 s. The one heavy step is
 * FIT_NULL (DVT case sets only): a full-GRM SAIGE null fit, about 1 h each.
 * EFFECTIVE_TESTS simulates 400,000 max-T draws on numpy's BLAS; it exports
 * OMP/OPENBLAS threads = ext.threads before Python starts, or BLAS takes every
 * core on the node. MAXT_BOOT (benchmark) reruns every test on 10,000
 * bootstrap phenotypes with plink2, 500 per run: about 5 min per allele set
 * and 20 min per residue set at 4 threads.
 * ==========================================================================*/

params.threadsNull  = 8
params.threadsAssoc = 4
params.threadsPlot  = 4
params.threadsSmall = 2

params.run_info_dir = "${projectDir}/results/_run_info"

process {
    // 'finish' rather than 'terminate': a failing figure lets the running
    // association tasks complete, and a -resume after the fix starts from them.
    errorStrategy = 'finish'

    withName: 'ASSOC_FIXED|ASSOC_RANDOM|CONDITIONAL|HLA_GIVEN_SIGNAL|STEPWISE|EFFECTIVE_TESTS|MAXT_BOOT' {
        ext.threads    = params.threadsAssoc
        clusterOptions = "--rsc p=1:t=${params.threadsAssoc}:c=${params.threadsAssoc}:m=18284M"
    }
    withName: 'FIT_NULL' {
        // SAIGE step 1, full GRM on ~2,000-2,800 samples x ~378k markers. The
        // genome-wide 'main' fits took about 1 h at ~2 cores of CPU and 0.7 GB
        // peak RSS, so 8 cores is ample.
        ext.threads    = params.threadsNull
        clusterOptions = "--rsc p=1:t=${params.threadsNull}:c=${params.threadsNull}:m=36568M"
    }
    withName: 'FIGURES|CASE_SET_COMPARE|CONDITIONAL_COMPARE' {
        ext.threads    = params.threadsPlot
        clusterOptions = "--rsc p=1:t=${params.threadsPlot}:c=${params.threadsPlot}:m=18284M"
    }
    // NULL_MODEL_INFO runs inside two sub-workflows; match the qualified names too.
    withName: 'NULL_MODEL_INFO|.*:NULL_MODEL_INFO|BUILD_MARKERS|COLLECT|COMPARE|EXTRACT_LEAD|BUILD_POOLED|OMNIBUS|OMNIBUS_GIVEN' {
        ext.threads    = params.threadsSmall
        clusterOptions = "--rsc p=1:t=${params.threadsSmall}:c=${params.threadsSmall}:m=9142M"
    }
}

// overwrite = true means a -resume's trace REPLACES the original run's record.
// Copy _run_info/ aside before resuming if the timings matter.
trace    { enabled = true; overwrite = true; file = "${params.run_info_dir}/trace.txt"
           fields = 'task_id,hash,name,status,exit,attempt,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar' }
report   { enabled = true; overwrite = true; file = "${params.run_info_dir}/report.html" }
timeline { enabled = true; overwrite = true; file = "${params.run_info_dir}/timeline.html" }
dag      { enabled = true; overwrite = true; file = "${params.run_info_dir}/dag.html" }

manifest {
    name        = 'assoc_hla.v2'
    description = 'HLA allele and amino-acid residue association on the hla.typing.v2 matrices: three nested cohorts, a fixed-effect logistic model (plink2) and a random-effect logistic mixed model (SAIGE), both adjusted for sex and 10 BBJ-mainland PCs.'
}
