// assoc_rvtest — execution profile.
// Resources go through --rsc only. Tools read `ext.threads` (task.cpus is unusable:
// it defaults to 1, so an elvis fallback silently runs single-threaded).
// --rsc t=threads, c=cores; this site also permits t = 2c.
//
// Everything from SPLIT_CALLSET to RVTEST runs PER CHROMOSOME, so each task sees
// roughly a tenth of the genome (the largest chromosome carries 9.0 % of
// variants). Memory is sized for that slice, not for the whole call set — the
// pre-split figures were 2-4x these and would now idle most of the reservation.

params.threadsSplit      = 4    // plink2 --chr subset + --mac
params.threadsPrepare    = 8    // plink2 export + bcftools, one chromosome
params.threadsAnnotate   = 8    // snpEff workers; the wall-clock driver
params.threadsImpact     = 4    // streaming INFO filter
params.threadsRvtest     = 4    // rvtest --numThread
params.threadsSmall      = 2    // merge / scan / figures / per-gene detail

process {
    errorStrategy = 'terminate'

    withName: 'SPLIT_CALLSET' {
        ext.threads    = params.threadsSplit
        clusterOptions = "--rsc p=1:t=${params.threadsSplit}:c=${params.threadsSplit}:m=36568M"
    }
    withName: 'PREPARE' {
        ext.threads    = params.threadsPrepare
        clusterOptions = "--rsc p=1:t=${params.threadsPrepare}:c=${params.threadsPrepare}:m=72536M"
    }
    // snpEff holds its database in memory regardless of how much sequence it is
    // annotating, so this one does NOT scale down with the chromosome split.
    withName: 'ANNOTATE' {
        ext.threads    = params.threadsAnnotate
        clusterOptions = "--rsc p=1:t=${params.threadsAnnotate}:c=${params.threadsAnnotate}:m=72536M"
    }
    withName: 'IMPACT_FILTER' {
        ext.threads    = params.threadsImpact
        clusterOptions = "--rsc p=1:t=${params.threadsImpact}:c=${params.threadsImpact}:m=36568M"
    }
    withName: 'RVTEST' {
        ext.threads    = params.threadsRvtest
        clusterOptions = "--rsc p=1:t=${params.threadsRvtest}:c=${params.threadsRvtest}:m=36568M"
    }
    // Reads 22 gene tables and writes one; the whole scan is a few thousand rows.
    withName: 'MERGE_ASSOC|GENE_SCAN|PLOT_SCAN' {
        ext.threads    = params.threadsSmall
        clusterOptions = "--rsc p=1:t=${params.threadsSmall}:c=${params.threadsSmall}:m=18284M"
    }
    // bcftools/plink2 lookups over one gene's window plus a ToMMo query.
    withName: 'GENE_DETAIL' {
        ext.threads    = params.threadsSmall
        clusterOptions = "--rsc p=1:t=${params.threadsSmall}:c=${params.threadsSmall}:m=18284M"
    }
}

// Provenance. The previous configuration had none, so there was no way to tell a
// cached task from a completed one after the fact, and no record of where the
// wall-clock went — which is exactly the measurement the chromosome split was
// sized from.
params.run_info_dir = "${projectDir}/results/_run_info"

trace {
    enabled   = true
    overwrite = true
    file      = "${params.run_info_dir}/trace.txt"
    fields    = 'task_id,hash,name,status,exit,attempt,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.run_info_dir}/report.html"
}
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.run_info_dir}/timeline.html"
}
dag {
    enabled   = true
    overwrite = true
    file      = "${params.run_info_dir}/dag.html"
}
