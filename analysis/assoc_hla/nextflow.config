/* ============================================================================
 * assoc_hla — execution profile
 *
 * Resources go through clusterOptions --rsc ONLY. Nextflow's own cpus/memory
 * directives are rejected by this site's submitter, and `task.cpus` is unusable
 * because it defaults to 1 rather than null: an elvis fallback on it silently
 * runs single-threaded. Tools therefore read `task.ext.threads`.
 *
 * MEMORY IS 4,571 MB PER CORE at this site. Asking for more than cores x 4571
 * silently doubles the core count, so every m= below is a whole multiple of it:
 *   2 cores 9,142M · 4 cores 18,284M · 8 cores 36,568M · 16 cores 73,136M
 *
 * This component is SMALL. It tests about 150 alleles and 1,000 residues, not
 * 5.1 M variants, so everything except the null-model fit and the genome-wide
 * pruning runs in minutes on two or four cores. FIT_NULL is sized from a
 * measurement rather than a guess: the same fit in assoc_saige took 47 min to
 * 1 h at 680 MB peak, so its 32-core/146 GB request is far above what it uses.
 * ==========================================================================*/

params.threadsFitNull   = 16
params.threadsPrune     = 8
params.threadsBuild     = 4
params.threadsAssoc     = 4
params.threadsSmall     = 2

params.run_info_dir = "${projectDir}/results/_run_info"

process {
    // A failure should be loud, and nothing here has a recoverable failure mode:
    // an engine that cannot fit, or a marker set that came out empty, is a result
    // to look at, not a task to retry.
    //
    // 'finish' rather than 'terminate', though. They report the same error and
    // neither retries; the difference is that 'terminate' KILLS every running
    // task, and a figure that fails in six seconds would take the three
    // half-hour FIT_NULL fits down with it and discard them. 'finish' lets what
    // is already running complete, so a -resume after the fix starts from the
    // cached null models instead of refitting them.
    errorStrategy = 'finish'

    withName: 'FIT_NULL' {
        ext.threads    = params.threadsFitNull
        clusterOptions = "--rsc p=1:t=${params.threadsFitNull}:c=${params.threadsFitNull}:m=73136M"
    }
    withName: 'PRUNE_MARKERS' {
        ext.threads    = params.threadsPrune
        clusterOptions = "--rsc p=1:t=${params.threadsPrune}:c=${params.threadsPrune}:m=36568M"
    }
    withName: 'BUILD_MARKERS' {
        // Holds both dosage matrices in memory at once — 17 MB + 23 MB on disk,
        // a few hundred MB as float64 — plus the genotype string array.
        ext.threads    = params.threadsBuild
        clusterOptions = "--rsc p=1:t=${params.threadsBuild}:c=${params.threadsBuild}:m=18284M"
    }
    withName: 'ASSOC_FIXED|ASSOC_RANDOM|EXPORT_TESTED' {
        ext.threads    = params.threadsAssoc
        clusterOptions = "--rsc p=1:t=${params.threadsAssoc}:c=${params.threadsAssoc}:m=18284M"
    }
    withName: 'OMNIBUS|SIGNIFICANCE' {
        // OMNIBUS fits two logistic models per position over ~300 positions;
        // SIGNIFICANCE eigendecomposes a ~1000 x 1000 correlation matrix.
        ext.threads    = params.threadsAssoc
        clusterOptions = "--rsc p=1:t=${params.threadsAssoc}:c=${params.threadsAssoc}:m=18284M"
    }
    withName: 'GENE_COORDS|MARKER_QC|PREP_PHENO_COV' {
        ext.threads    = params.threadsSmall
        clusterOptions = "--rsc p=1:t=${params.threadsSmall}:c=${params.threadsSmall}:m=9142M"
    }
}

// overwrite = true means a -resume's trace REPLACES the original run's record.
// That is the intended behaviour here — the trace should describe the tree as it
// now stands — but it does mean a full run's timings are lost the moment it is
// resumed for a one-task fix.
trace    { enabled = true; overwrite = true; file = "${params.run_info_dir}/trace.txt"
           fields = 'task_id,hash,name,status,exit,attempt,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar' }
report   { enabled = true; overwrite = true; file = "${params.run_info_dir}/report.html" }
timeline { enabled = true; overwrite = true; file = "${params.run_info_dir}/timeline.html" }
dag      { enabled = true; overwrite = true; file = "${params.run_info_dir}/dag.html" }

manifest {
    name        = 'assoc_hla'
    description = 'HLA allele and amino-acid association: fixed and full-GRM random models, three cohorts.'
}
