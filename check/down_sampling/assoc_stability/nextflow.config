process {
    withName: 'BUILD_SNP_BASELINE' {
        clusterOptions = '--rsc p=1:t=4:c=4:m=32768M'
    }
    // SAIGE step 2 loads the null model's GRM; it is the memory-hungry step here.
    withName: 'SNP_ASSOC' {
        clusterOptions = '--rsc p=1:t=8:c=8:m=65536M'
    }
    withName: 'GENE_ASSOC_PREP' {
        clusterOptions = '--rsc p=1:t=4:c=4:m=32768M'
    }
    // t/c must match rvtest --numThread in gene_assoc_run.sh.
    withName: 'GENE_ASSOC_RUN' {
        clusterOptions = '--rsc p=1:t=4:c=4:m=32768M'
    }
    withName: 'GT_TABLES' {
        clusterOptions = '--rsc p=1:t=2:c=2:m=16384M'
    }
    withName: 'MAKE_SUBSETS' {
        clusterOptions = '--rsc p=1:t=2:c=2:m=16384M'
    }
    // Same shape as the reference run's FitNullGlmmFullGrm: step 1 fits a full GRM
    // over 204k pruned markers and is the memory-hungry step.
    withName: 'SAIGE_SUBSET' {
        clusterOptions = '--rsc p=1:t=32:c=32:m=292544M'
    }
    withName: 'PLATFORM_REPORT' {
        clusterOptions = '--rsc p=1:t=2:c=2:m=16384M'
    }
    withName: 'ASSOC_REPORT' {
        clusterOptions = '--rsc p=1:t=2:c=2:m=16384M'
    }
}
