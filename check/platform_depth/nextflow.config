/* ============================================================================
 * check/platform_depth — execution profile
 *
 * Resources go through clusterOptions --rsc ONLY: Nextflow's cpus/memory directives
 * are rejected by this site's submitter, and task.cpus defaults to 1 rather than null.
 * Tools read task.ext.threads.
 *
 * MEMORY IS 4,571 MB PER CORE at this site; more than cores x 4571 silently doubles
 * the core count, so every m= below is cores x 4571M:
 *   1 core 4,571M · 2 cores 9,142M · 4 cores 18,284M · 8 cores 36,568M
 *
 * Queues: gr10478b (no short limit) and eb (1 h limit). Either can sit PENDING on
 * QOSGrpCpuLimit from group use that squeue does not show; switch with
 * --queue_long / --queue_short.
 * ==========================================================================*/

params.queue_long  = 'gr10478b'
params.queue_short = 'gr10478b'

params.threadsSmall = 1
params.threadsDepth = 2
params.threadsCall  = 4
params.threadsHla   = 4
params.threadsNull  = 4
params.threadsAssoc = 2

params.run_tag      = 'run'
params.run_info_dir = "${projectDir}/results/_run_info/${params.run_tag}"

process {
    executor       = 'slurm'
    queue          = params.queue_long
    errorStrategy  = 'finish'
    // default: one core; every heavier process is set below
    ext.threads    = 1
    clusterOptions = '--rsc p=1:t=1:c=1:m=4571M'

    withName: 'SAMPLE_TABLE|BUILD_TARGETS|DEPTH_SUMMARY|SUBSET_ORIGINAL|GATE_G1|RETEST_GWAS|RETEST_GENE|RETEST_HLA|RETEST_OMNIBUS' {
        ext.threads    = params.threadsSmall * 2
        clusterOptions = "--rsc p=1:t=${params.threadsSmall * 2}:c=${params.threadsSmall * 2}:m=${params.threadsSmall * 2 * 4571}M"
    }
    withName: 'DEPTH' {
        ext.threads    = params.threadsDepth
        clusterOptions = "--rsc p=1:t=${params.threadsDepth}:c=${params.threadsDepth}:m=${params.threadsDepth * 4571}M"
    }
    // hla.typing.v2 step 01 runs a pool of 8 worker processes
    withName: 'HLA_CHAIN' {
        ext.threads    = 8
        clusterOptions = '--rsc p=1:t=8:c=8:m=36568M'
    }
    // HLA-HD as the typing run: -t 4; peak RSS 4-6.5 GB
    withName: 'HLAHD' {
        ext.threads    = params.threadsHla
        clusterOptions = "--rsc p=1:t=${params.threadsHla}:c=${params.threadsHla}:m=${params.threadsHla * 4571}M"
    }
    // GATK: HaplotypeCaller heap 6 GB on 2 cores; GenomicsDB / GenotypeGVCFs 12 GB and the sif (8 GB) on 4 cores
    withName: 'CALL_GVCF' {
        ext.threads    = 2
        clusterOptions = '--rsc p=1:t=2:c=2:m=9142M'
    }
    withName: 'JOINT|GENOTYPE_QC|FIT_NULL' {
        ext.threads    = 4
        clusterOptions = '--rsc p=1:t=4:c=4:m=18284M'
    }
    withName: 'EXTRACT_READS|SUBSAMPLE|HLA_SUBSAMPLE|SWAP|HLA_INPUTS|HLA_MATRICES|CONCORDANCE|QC_REASONS|HLA_CONCORDANCE|MAKE_SUBSETS|PLATFORM_GENO|STEP2_SUBSET|PLATFORM_GENE|CARRIER_FIRTH|PLATFORM_OMNIBUS|PLATFORM_STATS|DS_SUMMARY|PLATFORM_REPORT|FIGURES' {
        ext.threads    = 2
        clusterOptions = '--rsc p=1:t=2:c=2:m=9142M'
    }
}

// overwrite = false: each run_tag keeps its own record; a later run cannot replace the
// pilot's timings.
trace    { enabled = true; overwrite = false; file = "${params.run_info_dir}/trace.txt"
           fields = 'task_id,hash,native_id,name,status,exit,attempt,submit,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar' }
report   { enabled = true; overwrite = false; file = "${params.run_info_dir}/report.html" }
timeline { enabled = true; overwrite = false; file = "${params.run_info_dir}/timeline.html" }

manifest {
    name        = 'platform_depth'
    description = 'Read down-sampling and platform-sensitivity re-tests of the CTEPH signals (16 GWAS loci, Tier 1-2 genes, HLA) in three nested cohorts.'
}
